{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "echo \"no npm install needed — Flutter handles deps in the build step\"",
  "buildCommand": "bash vercel-build.sh",
  "outputDirectory": "apps/admin/build/web",
  "rewrites": [
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
